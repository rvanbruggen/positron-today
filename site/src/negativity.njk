---
layout: base.njk
title: The News That Gets Skipped
---

<style>
  .page-header { margin-bottom: 1.5rem; }
  .page-header h1 { font-size: clamp(1.35rem,5vw,1.75rem); font-weight:700; color:#78350f; margin-bottom:0.5rem; }
  .page-header p  { font-size:0.9rem; color:#b45309; line-height:1.6; }

  /* ── Summary stats ── */
  .stat-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:1rem; margin-bottom:2rem; }
  .stat-card { background:#fff; border:2px solid #fde047; border-radius:1rem; padding:1.25rem 1rem; text-align:center; }
  .stat-num  { font-size:2rem; font-weight:700; color:#78350f; }
  .stat-lbl  { font-size:0.75rem; color:#b45309; margin-top:0.25rem; }

  /* ── Category breakdown chart ── */
  .breakdown-section { background:#fff; border:1.5px solid #fde68a; border-radius:1rem; padding:1.25rem 1.5rem; margin-bottom:2rem; }
  .breakdown-title { font-size:0.75rem; font-weight:700; color:#b45309; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:1rem; }
  .breakdown-row { display:flex; align-items:center; gap:0.6rem; margin-bottom:0.55rem; }
  .breakdown-label { font-size:0.78rem; color:#78350f; width:180px; flex-shrink:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .breakdown-bar-wrap { flex:1; height:8px; background:#fef3c7; border-radius:99px; overflow:hidden; }
  .breakdown-bar { height:100%; border-radius:99px; }
  .breakdown-count { font-size:0.72rem; color:#b45309; width:42px; text-align:right; flex-shrink:0; }

  /* ── Source breakdown ── */
  .source-breakdown-section { background:#fff; border:1.5px solid #fde68a; border-radius:1rem; padding:1.25rem 1.5rem; margin-bottom:2rem; }
  .source-breakdown-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem; margin-bottom:1rem; }
  .source-sort-toggle {
    display:flex; gap:0; border:1.5px solid #fde68a; border-radius:99px; overflow:hidden;
  }
  .source-sort-btn {
    padding:0.25rem 0.75rem; font-size:0.7rem; font-weight:600; cursor:pointer;
    background:#fff; color:#78350f; border:none; font-family:inherit; transition:background 0.15s;
  }
  .source-sort-btn.active { background:#facc15; }
  .source-row { display:flex; align-items:center; gap:0.6rem; margin-bottom:0.55rem; }
  .source-label { font-size:0.78rem; color:#78350f; width:200px; flex-shrink:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .source-bar-wrap { flex:1; height:8px; background:#fef3c7; border-radius:99px; overflow:hidden; }
  .source-bar { height:100%; border-radius:99px; background:#f59e0b; }
  .source-count { font-size:0.72rem; color:#b45309; width:120px; text-align:right; flex-shrink:0; white-space:nowrap; }

  /* ── Filter bar ── */
  .filter-bar { display:flex; gap:0.5rem; margin-bottom:1.25rem; flex-wrap:wrap; }
  .cat-pill {
    padding:0.3rem 0.8rem; border-radius:99px; font-size:0.75rem; font-weight:600;
    cursor:pointer; border:1.5px solid #fde68a; background:#fff; color:#78350f;
    transition:background 0.15s; white-space:nowrap;
  }
  .cat-pill.active { background:#facc15; border-color:#f59e0b; }

  /* ── Article cards ── */
  .rejection-list { display:flex; flex-direction:column; gap:0.75rem; }
  .rejection-card {
    background:#fff7ed; border:1.5px solid #fde68a; border-radius:0.75rem;
    padding:0.9rem 1.1rem;
  }
  .rejection-card[data-cat] { border-left-width:4px; }
  .rejection-title { font-size:0.9rem; font-weight:600; color:#78350f; line-height:1.4; }
  .rejection-meta  { font-size:0.75rem; color:#b45309; margin-top:0.3rem; display:flex; gap:0.75rem; flex-wrap:wrap; align-items:center; }
  .cat-badge {
    display:inline-flex; align-items:center; gap:0.3rem;
    font-size:0.7rem; font-weight:600; padding:0.15rem 0.55rem;
    border-radius:99px; border:1px solid currentColor;
  }
  .rejection-reason { font-size:0.82rem; color:#92400e; margin-top:0.5rem; line-height:1.55; }
  .rejection-reason::before { content:"✗ "; color:#ef4444; }

  .empty { color:#b45309; font-size:0.9rem; }
  .updated { font-size:0.75rem; color:#d97706; margin-bottom:1.5rem; }

  /* ── Section headings ── */
  .section-heading {
    font-size:1.1rem; font-weight:700; color:#78350f;
    margin:2rem 0 0.75rem; padding-bottom:0.5rem;
    border-bottom:2px solid #fde68a;
  }

  /* ── Tab switcher ── */
  .tab-bar { display:flex; gap:0.5rem; margin-bottom:1.5rem; flex-wrap:wrap; }
  .tab-btn {
    padding:0.45rem 1rem; border-radius:99px; font-size:0.8rem; font-weight:700;
    cursor:pointer; border:1.5px solid #fde68a; background:#fff; color:#78350f;
    font-family:inherit; transition:background 0.15s; white-space:nowrap;
  }
  .tab-btn[aria-selected="true"] { background:#facc15; border-color:#f59e0b; }

  /* ── Necessary Negativity ── */
  .nn-intro { font-size:0.9rem; color:#92400e; line-height:1.65; margin-bottom:1rem; }
  .nn-intro strong { color:#78350f; }
  .nn-theme-grid {
    display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
    gap:0.75rem; margin:1.25rem 0;
  }
  .nn-theme-card {
    background:#fff; border:1.5px solid #fde68a; border-left-width:5px;
    border-radius:0.75rem; padding:0.9rem 1rem;
  }
  .nn-theme-name { font-size:0.85rem; font-weight:700; color:#78350f; margin-bottom:0.35rem; }
  .nn-theme-desc { font-size:0.78rem; color:#92400e; line-height:1.5; }
  .nn-note {
    background:#fffbeb; border:1.5px solid #fde68a; border-radius:0.75rem;
    padding:0.9rem 1.1rem; font-size:0.82rem; color:#92400e; line-height:1.6;
    margin-bottom:2rem;
  }
  .nn-note strong { color:#78350f; }

  .nn-week { margin-bottom:1rem; border:1.5px solid #fde68a; border-radius:0.75rem; background:#fff; overflow:hidden; }
  .nn-week > summary {
    cursor:pointer; padding:0.85rem 1.1rem; font-size:0.9rem; font-weight:700;
    color:#78350f; list-style:none; display:flex; align-items:center; gap:0.5rem;
  }
  .nn-week > summary::-webkit-details-marker { display:none; }
  .nn-week > summary::before { content:"▸"; color:#d97706; font-size:0.8rem; }
  .nn-week[open] > summary::before { content:"▾"; }
  .nn-week > summary:hover { background:#fffbeb; }
  .nn-week-body { padding:0 1.1rem 1.1rem; }

  .nn-theme-block { margin-top:1.25rem; padding-top:1rem; border-top:1px solid #fef3c7; }
  .nn-theme-block:first-child { border-top:none; padding-top:0; }
  .nn-theme-heading {
    font-size:0.8rem; font-weight:700; color:#78350f;
    text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;
  }
  .nn-summary { font-size:0.85rem; color:#92400e; line-height:1.6; margin-bottom:0.85rem; }
  .nn-stories { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.6rem; }
  .nn-story { border-left:3px solid #fde68a; padding-left:0.75rem; }
  .nn-story a { color:#78350f; font-weight:600; font-size:0.88rem; line-height:1.45; text-decoration:none; }
  .nn-story a:hover { text-decoration:underline; }
  .nn-story-meta { font-size:0.72rem; color:#b45309; margin-top:0.25rem; }
  .nn-considered { font-size:0.72rem; color:#d97706; margin-top:0.6rem; font-style:italic; }

  /* ── Pagination controls ── */
  .pagination-bar {
    display:flex; align-items:center; gap:0.5rem;
    flex-wrap:wrap; margin-bottom:1.25rem;
  }
  .page-size-label { font-size:0.75rem; color:#b45309; white-space:nowrap; }
  .page-size-select {
    padding:0.3rem 0.6rem; border-radius:0.5rem; font-size:0.78rem;
    border:1.5px solid #fde68a; background:#fff; color:#78350f;
    font-family:inherit; cursor:pointer;
  }
  .page-size-select:focus { outline:none; border-color:#f59e0b; }
  .page-info { font-size:0.75rem; color:#b45309; margin-left:auto; white-space:nowrap; }
  .page-btn {
    padding:0.3rem 0.75rem; border-radius:0.5rem; font-size:0.78rem; font-weight:600;
    border:1.5px solid #fde68a; background:#fff; color:#78350f;
    cursor:pointer; transition:background 0.15s;
  }
  .page-btn:hover:not(:disabled) { background:#fef3c7; }
  .page-btn:disabled { opacity:0.35; cursor:default; }
</style>

{% set catMeta = {
  "war-conflict":            { label_en: "War & Conflict",            label_nl: "Oorlog & Conflict",            label_fr: "Guerre & Conflit",            emoji: "⚔️",  color: "#fca5a5", border: "#f87171" },
  "crime-violence":          { label_en: "Crime & Violence",          label_nl: "Misdaad & Geweld",             label_fr: "Crime & Violence",            emoji: "🔫",  color: "#fdba74", border: "#fb923c" },
  "political-conflict":      { label_en: "Political Conflict",        label_nl: "Politiek Conflict",            label_fr: "Conflit Politique",           emoji: "🏛️",  color: "#d8b4fe", border: "#c084fc" },
  "economic-doom":           { label_en: "Economic Doom",             label_nl: "Economische Ellende",          label_fr: "Catastrophe Économique",      emoji: "📉",  color: "#fde047", border: "#facc15" },
  "disaster-accident":       { label_en: "Disaster & Accident",       label_nl: "Ramp & Ongeluk",               label_fr: "Catastrophe & Accident",      emoji: "🌊",  color: "#93c5fd", border: "#60a5fa" },
  "health-scare":            { label_en: "Health Scare",              label_nl: "Gezondheidsalarm",             label_fr: "Alerte Sanitaire",            emoji: "🦠",  color: "#86efac", border: "#4ade80" },
  "divisive-social":         { label_en: "Divisive & Social Tension", label_nl: "Verdeeldheid & Spanningen",    label_fr: "Tensions Sociales",           emoji: "⚡",  color: "#fcd34d", border: "#fbbf24" },
  "lgbtq-rights":            { label_en: "LGBTQ Rights",              label_nl: "LGBTQ-rechten",                label_fr: "Droits LGBTQ",                emoji: "🏳️‍🌈", color: "#f9a8d4", border: "#f472b6" },
  "divisive-racism":         { label_en: "Divisive & Racism",         label_nl: "Verdeeldheid & Racisme",       label_fr: "Racisme & Division",          emoji: "✊",  color: "#d6d3d1", border: "#a8a29e" },
  "sports-negative":         { label_en: "Sports & Competition",      label_nl: "Sport & Competitie",           label_fr: "Sport & Compétition",         emoji: "⚽",  color: "#bef264", border: "#84cc16" },
  "celebrity-entertainment": { label_en: "Celebrity & Entertainment", label_nl: "Celebrities & Entertainment",  label_fr: "Célébrités & Divertissement", emoji: "🎬",  color: "#f0abfc", border: "#d946ef" },
  "tech-ai-concern":         { label_en: "Tech & AI Anxiety",         label_nl: "Tech & AI-zorgen",             label_fr: "Inquiétudes Tech & IA",       emoji: "🤖",  color: "#a5f3fc", border: "#06b6d4" },
  "climate-environment":     { label_en: "Climate & Environment",     label_nl: "Klimaat & Milieu",             label_fr: "Climat & Environnement",      emoji: "🌍",  color: "#99f6e4", border: "#14b8a6" },
  "soft-news-filler":        { label_en: "Soft News & Filler",        label_nl: "Soft news & opvulling",        label_fr: "Info légère & remplissage",   emoji: "📰",  color: "#e2e8f0", border: "#94a3b8" },
  "other-negative":          { label_en: "Other Negative",            label_nl: "Overig Negatief",              label_fr: "Autre Négatif",               emoji: "😔",  color: "#d1d5db", border: "#9ca3af" }
} %}

<div class="tab-bar" role="tablist">
  <button class="tab-btn" role="tab" id="tab-skipped" aria-selected="true" aria-controls="pane-skipped" onclick="showTab('skipped')">
    <span class="t-en">What gets skipped</span>
    <span class="t-nl" style="display:none">Wat wordt overgeslagen</span>
    <span class="t-fr" style="display:none">Ce qui est ignoré</span>
  </button>
  <button class="tab-btn" role="tab" id="tab-necessary" aria-selected="false" aria-controls="pane-necessary" onclick="showTab('necessary')">
    <span class="t-en">Necessary Negativity</span>
    <span class="t-nl" style="display:none">Noodzakelijke negativiteit</span>
    <span class="t-fr" style="display:none">La négativité nécessaire</span>
  </button>
</div>

<div id="pane-skipped" role="tabpanel" aria-labelledby="tab-skipped">

<div class="page-header">
  <h1>
    <span class="t-en">The News That Gets Skipped 🚫</span>
    <span class="t-nl" style="display:none">Het nieuws dat wordt overgeslagen 🚫</span>
    <span class="t-fr" style="display:none">Les nouvelles qui sont ignorées 🚫</span>
  </h1>
  <p>
    <span class="t-en">Every time news sources get scanned, an AI reads the headline and filters out stories that are negative, anxiety-inducing, or just plain gloomy. This page shows what gets left behind — a transparent illustration of how skewed towards the negative most news coverage tends to be. The statistics below cover every article that has ever been filtered out. The browsable list at the bottom shows the 1,000 most recent rejections.</span>
    <span class="t-nl" style="display:none">Elke keer dat nieuwsbronnen worden gescand, leest een AI de kop en filtert verhalen die negatief, angstaanjagend of gewoon somber zijn. Deze pagina toont wat er overblijft — een transparante illustratie van hoe sterk het nieuws naar het negatieve neigt. De statistieken hieronder omvatten elk artikel dat ooit is gefilterd. De doorzoekbare lijst onderaan toont de 1.000 meest recente afwijzingen.</span>
    <span class="t-fr" style="display:none">Chaque fois que les sources d'actualité sont analysées, une IA lit le titre et filtre les articles négatifs, anxiogènes ou simplement moroses. Cette page montre ce qui reste — une illustration transparente du biais négatif dominant dans les médias. Les statistiques ci-dessous couvrent chaque article qui a été filtré. La liste consultable en bas affiche les 1 000 rejets les plus récents.</span>
  </p>
</div>


{% if rejections.total_rejected == 0 %}
  <p class="empty">
    <span class="t-en">No data yet — the rejection log will appear here after the first fetch.</span>
    <span class="t-nl" style="display:none">Nog geen data — het logboek verschijnt hier na de eerste fetch.</span>
    <span class="t-fr" style="display:none">Pas encore de données — le journal apparaîtra ici après la première récupération.</span>
  </p>
{% else %}

  {% if rejections.exported_at %}
  <p class="updated">
    <span class="t-en">Last updated: {{ rejections.exported_at | truncate(10, true, "") }}</span>
    <span class="t-nl" style="display:none">Laatste update: {{ rejections.exported_at | truncate(10, true, "") }}</span>
    <span class="t-fr" style="display:none">Dernière mise à jour : {{ rejections.exported_at | truncate(10, true, "") }}</span>
  </p>
  {% endif %}

  <!-- Stats heading -->
  <h2 class="section-heading">
    <span class="t-en">All-time statistics — {{ rejections.total_rejected }} articles filtered</span>
    <span class="t-nl" style="display:none">Statistieken over alle tijd — {{ rejections.total_rejected }} artikelen gefilterd</span>
    <span class="t-fr" style="display:none">Statistiques globales — {{ rejections.total_rejected }} articles filtrés</span>
  </h2>

  <!-- Summary stats -->
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-num">{{ rejections.total_rejected }}</div>
      <div class="stat-lbl">
        <span class="t-en">articles filtered out</span>
        <span class="t-nl" style="display:none">artikels gefilterd</span>
        <span class="t-fr" style="display:none">articles filtrés</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-num">{{ rejections.sources_count }}</div>
      <div class="stat-lbl">
        <span class="t-en">news sources scanned</span>
        <span class="t-nl" style="display:none">nieuwsbronnen gescand</span>
        <span class="t-fr" style="display:none">sources analysées</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-num">{{ rejections.articles.length }}</div>
      <div class="stat-lbl">
        <span class="t-en">shown here</span>
        <span class="t-nl" style="display:none">hier weergegeven</span>
        <span class="t-fr" style="display:none">affichés ici</span>
      </div>
    </div>
  </div>

  <!-- Category breakdown chart -->
  {% if rejections.category_breakdown and rejections.category_breakdown.length > 0 %}
  <div class="breakdown-section">
    <div class="breakdown-title">
      <span class="t-en">What kind of negativity dominates the news</span>
      <span class="t-nl" style="display:none">Welk soort negativiteit domineert het nieuws</span>
      <span class="t-fr" style="display:none">Quel type de négativité domine l'actualité</span>
    </div>
    {% for row in rejections.category_breakdown %}
      {% set meta = catMeta[row.category] %}
      {% if meta %}
      {% set pct = (row.count / rejections.total_rejected * 100) | round %}
      <div class="breakdown-row">
        <div class="breakdown-label">
          {{ meta.emoji }}&nbsp;
          <span class="t-en">{{ meta.label_en }}</span>
          <span class="t-nl" style="display:none">{{ meta.label_nl }}</span>
          <span class="t-fr" style="display:none">{{ meta.label_fr }}</span>
        </div>
        <div class="breakdown-bar-wrap">
          <div class="breakdown-bar" style="width:{{ pct }}%; background-color:{{ meta.border }};"></div>
        </div>
        <div class="breakdown-count">{{ row.count }} ({{ pct }}%)</div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <!-- Source breakdown -->
  {% if rejections.source_breakdown and rejections.source_breakdown.length > 0 %}
  <div class="source-breakdown-section">
    <div class="source-breakdown-header">
      <div class="breakdown-title" style="margin-bottom:0;">
        <span class="t-en">Negativity by news source</span>
        <span class="t-nl" style="display:none">Negativiteit per nieuwsbron</span>
        <span class="t-fr" style="display:none">Négativité par source d'actualité</span>
      </div>
      <div class="source-sort-toggle">
        <button class="source-sort-btn active" id="sort-abs-btn" onclick="sortSources('absolute')">
          <span class="t-en">Absolute</span>
          <span class="t-nl" style="display:none">Absoluut</span>
          <span class="t-fr" style="display:none">Absolu</span>
        </button>
        <button class="source-sort-btn" id="sort-rel-btn" onclick="sortSources('relative')">
          <span class="t-en">Relative</span>
          <span class="t-nl" style="display:none">Relatief</span>
          <span class="t-fr" style="display:none">Relatif</span>
        </button>
      </div>
    </div>
    <div id="source-breakdown-list"></div>
  </div>
  {% endif %}

  <!-- List heading -->
  <h2 class="section-heading">
    <span class="t-en">Most recent 1,000 skipped articles</span>
    <span class="t-nl" style="display:none">Meest recente 1.000 overgeslagen artikelen</span>
    <span class="t-fr" style="display:none">Les 1 000 articles ignorés les plus récents</span>
  </h2>

  <!-- Category filter pills -->
  {% if rejections.category_breakdown and rejections.category_breakdown.length > 0 %}
  <div class="filter-bar" id="cat-filter-bar">
    <button class="cat-pill active" onclick="filterCat('all', this)">
      <span class="t-en">All</span>
      <span class="t-nl" style="display:none">Alles</span>
      <span class="t-fr" style="display:none">Tout</span>
    </button>
    {% for row in rejections.category_breakdown %}
      {% set meta = catMeta[row.category] %}
      {% if meta %}
      <button class="cat-pill" onclick="filterCat('{{ row.category }}', this)" data-cat="{{ row.category }}">
        {{ meta.emoji }}&nbsp;
        <span class="t-en">{{ meta.label_en }}</span>
        <span class="t-nl" style="display:none">{{ meta.label_nl }}</span>
        <span class="t-fr" style="display:none">{{ meta.label_fr }}</span>
        ({{ row.count }})
      </button>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <!-- Pagination bar (top) -->
  <div class="pagination-bar" id="pagination-bar-top">
    <span class="page-size-label">
      <span class="t-en">Show</span>
      <span class="t-nl" style="display:none">Toon</span>
      <span class="t-fr" style="display:none">Afficher</span>
    </span>
    <select class="page-size-select" id="page-size-select" onchange="setPageSize(+this.value)">
      <option value="50">50</option>
      <option value="100" selected>100</option>
      <option value="250">250</option>
    </select>
    <button class="page-btn" id="prev-btn-top" onclick="changePage(-1)">&#8592;</button>
    <button class="page-btn" id="next-btn-top" onclick="changePage(+1)">&#8594;</button>
    <span class="page-info" id="page-info-top"></span>
  </div>

  <!-- Article list (JS-rendered) -->
  <div class="rejection-list" id="rejection-list"></div>

  <!-- Pagination bar (bottom) -->
  <div class="pagination-bar" id="pagination-bar-bottom" style="margin-top:1.25rem; margin-bottom:0;">
    <button class="page-btn" id="prev-btn-bottom" onclick="changePage(-1)">&#8592;</button>
    <button class="page-btn" id="next-btn-bottom" onclick="changePage(+1)">&#8594;</button>
    <span class="page-info" id="page-info-bottom"></span>
  </div>

{% endif %}

</div><!-- /pane-skipped -->

<div id="pane-necessary" role="tabpanel" aria-labelledby="tab-necessary" hidden>

{% set nnThemes = {
  "climate": { emoji: "🌍", accent: "#5eead4",
    name_en: "Climate & Environment", name_nl: "Klimaat & Milieu", name_fr: "Climat & Environnement",
    desc_en: "Droughts, heat records, collapsing species. The story barely changes week to week, which is exactly why it stops getting written.",
    desc_nl: "Droogtes, hitterecords, soorten die verdwijnen. Het verhaal verandert amper van week tot week, en net daarom wordt het niet meer geschreven.",
    desc_fr: "Sécheresses, records de chaleur, espèces qui s'effondrent. L'histoire change à peine d'une semaine à l'autre, et c'est précisément pour cela qu'on cesse de l'écrire." },
  "tech": { emoji: "🤖", accent: "#67e8f9",
    name_en: "Technology & AI", name_nl: "Technologie & AI", name_fr: "Technologie & IA",
    desc_en: "Automated decisions, surveillance, work that quietly disappears. Covered as product news far more often than as consequence.",
    desc_nl: "Geautomatiseerde beslissingen, surveillance, werk dat stilletjes verdwijnt. Veel vaker behandeld als productnieuws dan als gevolg.",
    desc_fr: "Décisions automatisées, surveillance, emplois qui disparaissent discrètement. Traité bien plus souvent comme actualité produit que comme conséquence." },
  "social": { emoji: "⚡", accent: "#fcd34d",
    name_en: "Division & Social Tension", name_nl: "Verdeeldheid & Sociale spanning", name_fr: "Division & Tensions sociales",
    desc_en: "Polarisation, racism, the slow fraying of what people are willing to assume about each other.",
    desc_nl: "Polarisatie, racisme, het traag rafelen van wat mensen nog van elkaar durven aannemen.",
    desc_fr: "Polarisation, racisme, l'effilochage lent de ce que les gens acceptent encore de présumer les uns des autres." }
} %}

{% set MONTHS = {
  en: ["January","February","March","April","May","June","July","August","September","October","November","December"],
  nl: ["januari","februari","maart","april","mei","juni","juli","augustus","september","oktober","november","december"],
  fr: ["janvier","février","mars","avril","mai","juin","juillet","août","septembre","octobre","novembre","décembre"]
} %}

<div class="page-header">
  <h1>
    <span class="t-en">Necessary Negativity ⚠️</span>
    <span class="t-nl" style="display:none">Noodzakelijke negativiteit ⚠️</span>
    <span class="t-fr" style="display:none">La négativité nécessaire ⚠️</span>
  </h1>
</div>

<p class="nn-intro">
  <span class="t-en">Positron exists to filter negative news out. Every story it removes is logged openly on the other tab — <strong>{{ neverskipStats.totalFormatted }}</strong> of them so far. But that pile is not uniform, and treating it as one undifferentiated heap hides something worth seeing.</span>
  <span class="t-nl" style="display:none">Positron bestaat om negatief nieuws eruit te filteren. Elk verhaal dat wordt weggelaten, staat openlijk gelogd op het andere tabblad — <strong>{{ neverskipStats.totalFormatted }}</strong> stuks tot nu toe. Maar die stapel is niet homogeen, en ze behandelen als één ongedifferentieerde hoop verbergt iets wat het bekijken waard is.</span>
  <span class="t-fr" style="display:none">Positron existe pour filtrer les mauvaises nouvelles. Chaque article écarté est consigné ouvertement sur l'autre onglet — <strong>{{ neverskipStats.totalFormatted }}</strong> à ce jour. Mais cette pile n'est pas homogène, et la traiter comme un tas indifférencié dissimule quelque chose qui mérite d'être vu.</span>
</p>

<p class="nn-intro">
  <span class="t-en">Three subjects in it are different in kind from the rest:</span>
  <span class="t-nl" style="display:none">Drie onderwerpen erin zijn wezenlijk anders dan de rest:</span>
  <span class="t-fr" style="display:none">Trois sujets y sont d'une nature différente du reste :</span>
</p>

<div class="nn-theme-grid">
  {% for key, t in nnThemes %}
  <div class="nn-theme-card" style="border-left-color:{{ t.accent }}">
    <div class="nn-theme-name">
      {{ t.emoji }}
      <span class="t-en">{{ t.name_en }}</span>
      <span class="t-nl" style="display:none">{{ t.name_nl }}</span>
      <span class="t-fr" style="display:none">{{ t.name_fr }}</span>
    </div>
    <div class="nn-theme-desc">
      <span class="t-en">{{ t.desc_en }}</span>
      <span class="t-nl" style="display:none">{{ t.desc_nl }}</span>
      <span class="t-fr" style="display:none">{{ t.desc_fr }}</span>
    </div>
  </div>
  {% endfor %}
</div>

<p class="nn-intro">
  <span class="t-en">None of these are events that happen and then resolve. They are slow, structural, and still consequential ten years from now. A crime story is negative for an afternoon; these are negative for a generation.</span>
  <span class="t-nl" style="display:none">Dit zijn geen gebeurtenissen die plaatsvinden en dan opgelost raken. Ze zijn traag, structureel, en over tien jaar nog altijd ingrijpend. Een misdaadverhaal is één namiddag negatief; dit is een generatie lang negatief.</span>
  <span class="t-fr" style="display:none">Ce ne sont pas des événements qui surviennent puis se résolvent. Ils sont lents, structurels, et encore lourds de conséquences dans dix ans. Un fait divers est négatif le temps d'un après-midi ; ceci est négatif le temps d'une génération.</span>
</p>

<p class="nn-intro">
  <span class="t-en">And they are being crowded out. Together, those three subjects account for <strong>{{ neverskipStats.themePct }}%</strong> of everything filtered. Political conflict alone accounts for <strong>{{ neverskipStats.comparisonPct }}%</strong> — more than {{ neverskipStats.ratio }} times as much. Add celebrity coverage, sport and disaster reporting, and the shape becomes clear: an ocean of low-stakes negativity, very good at drowning out the handful of stories that genuinely warrant the alarm.</span>
  <span class="t-nl" style="display:none">En ze worden verdrongen. Samen zijn die drie onderwerpen goed voor <strong>{{ neverskipStats.themePct }}%</strong> van alles wat gefilterd wordt. Politiek conflict alleen al is goed voor <strong>{{ neverskipStats.comparisonPct }}%</strong> — meer dan {{ neverskipStats.ratio }} keer zoveel. Tel daar beroemdheden, sport en rampen bij op en de vorm wordt duidelijk: een oceaan van negativiteit met lage inzet, bijzonder goed in het verdrinken van die handvol verhalen die de bezorgdheid wél verdienen.</span>
  <span class="t-fr" style="display:none">Et ces sujets sont étouffés. Ensemble, ils représentent <strong>{{ neverskipStats.themePct }} %</strong> de tout ce qui est filtré. Le conflit politique à lui seul en représente <strong>{{ neverskipStats.comparisonPct }} %</strong> — plus de {{ neverskipStats.ratio }} fois plus. Ajoutez les célébrités, le sport et les catastrophes, et la forme apparaît : un océan de négativité à faible enjeu, très efficace pour noyer la poignée d'articles qui méritent réellement l'inquiétude.</span>
</p>

<p class="nn-intro">
  <span class="t-en">That argument is set out in full in the editorial <a href="{{ '/editorials/the-negativity-we-actually-need/' | url }}" style="color:#b45309;font-weight:600;">The negativity we actually need</a>.</span>
  <span class="t-nl" style="display:none">Dat argument staat voluit in de column <a href="{{ '/editorials/the-negativity-we-actually-need/' | url }}" style="color:#b45309;font-weight:600;">De negativiteit die we echt nodig hebben</a>.</span>
  <span class="t-fr" style="display:none">Cet argument est développé dans l'éditorial <a href="{{ '/editorials/the-negativity-we-actually-need/' | url }}" style="color:#b45309;font-weight:600;">La négativité dont nous avons réellement besoin</a>.</span>
</p>

<p class="nn-intro">
  <span class="t-en">So once a week, the stories from those three subjects are pulled back out of the reject pile, near-duplicates from different outlets are merged, and an AI ranks what remains by consequence rather than by tone. The most significant are published below, newest week first.</span>
  <span class="t-nl" style="display:none">Daarom worden elke week de verhalen uit die drie onderwerpen weer uit de afwijzingsstapel gehaald, worden bijna-duplicaten van verschillende media samengevoegd, en rangschikt een AI wat overblijft op gevolg in plaats van op toon. De belangrijkste staan hieronder, met de recentste week eerst.</span>
  <span class="t-fr" style="display:none">Ainsi, chaque semaine, les articles de ces trois sujets sont ressortis de la pile des rejets, les quasi-doublons issus de médias différents sont fusionnés, et une IA classe ce qui reste selon la conséquence plutôt que selon le ton. Les plus significatifs sont publiés ci-dessous, la semaine la plus récente en premier.</span>
</p>

<div class="nn-note">
  <span class="t-en"><strong>Two honest caveats.</strong> This is not a list of things you are obliged to care about — ranking importance was never this site's job, and the ranking here is done by a machine that can get it wrong. And these stories were filtered for a reason: they are genuinely bad news. They appear here because being unimportant was never the reason they were skipped.</span>
  <span class="t-nl" style="display:none"><strong>Twee eerlijke kanttekeningen.</strong> Dit is geen lijst van dingen waar u zich zorgen over móét maken — belangrijkheid rangschikken was nooit de taak van deze site, en de rangschikking hier gebeurt door een machine die zich kan vergissen. En deze verhalen zijn niet zomaar gefilterd: het is echt slecht nieuws. Ze staan hier omdat onbelangrijkheid nooit de reden was waarom ze werden overgeslagen.</span>
  <span class="t-fr" style="display:none"><strong>Deux réserves honnêtes.</strong> Ceci n'est pas une liste de sujets dont vous seriez tenu de vous soucier — hiérarchiser l'importance n'a jamais été le rôle de ce site, et le classement présenté ici est établi par une machine qui peut se tromper. Et ces articles ont été filtrés pour une raison : ce sont de vraies mauvaises nouvelles. Ils figurent ici parce que leur insignifiance n'a jamais été le motif de leur mise à l'écart.</span>
</div>

{% if not neverskip.weeks or neverskip.weeks.length == 0 %}
  <p class="empty">
    <span class="t-en">No weeks published yet — the first weekly selection will appear here once it has been generated.</span>
    <span class="t-nl" style="display:none">Nog geen weken gepubliceerd — de eerste wekelijkse selectie verschijnt hier zodra ze is samengesteld.</span>
    <span class="t-fr" style="display:none">Aucune semaine publiée pour l'instant — la première sélection hebdomadaire apparaîtra ici une fois établie.</span>
  </p>
{% else %}
  {% for w in neverskip.weeks %}
    <details class="nn-week" {% if loop.first %}open{% endif %}>
      <summary>
        {% set sd = w.start.split("-") %}
        {% set ed = w.end.split("-") %}
        <span class="t-en">Week of {% if sd[1] == ed[1] %}{{ sd[2] | int }}–{{ ed[2] | int }} {{ MONTHS.en[(ed[1] | int) - 1] }} {{ ed[0] }}{% else %}{{ sd[2] | int }} {{ MONTHS.en[(sd[1] | int) - 1] }} – {{ ed[2] | int }} {{ MONTHS.en[(ed[1] | int) - 1] }} {{ ed[0] }}{% endif %}</span>
        <span class="t-nl" style="display:none">Week van {% if sd[1] == ed[1] %}{{ sd[2] | int }}–{{ ed[2] | int }} {{ MONTHS.nl[(ed[1] | int) - 1] }} {{ ed[0] }}{% else %}{{ sd[2] | int }} {{ MONTHS.nl[(sd[1] | int) - 1] }} – {{ ed[2] | int }} {{ MONTHS.nl[(ed[1] | int) - 1] }} {{ ed[0] }}{% endif %}</span>
        <span class="t-fr" style="display:none">Semaine du {% if sd[1] == ed[1] %}{{ sd[2] | int }}–{{ ed[2] | int }} {{ MONTHS.fr[(ed[1] | int) - 1] }} {{ ed[0] }}{% else %}{{ sd[2] | int }} {{ MONTHS.fr[(sd[1] | int) - 1] }} – {{ ed[2] | int }} {{ MONTHS.fr[(ed[1] | int) - 1] }} {{ ed[0] }}{% endif %}</span>
      </summary>
      <div class="nn-week-body">
        {% for block in w.themes %}
          {% set t = nnThemes[block.theme] %}
          <div class="nn-theme-block">
            <div class="nn-theme-heading">
              {{ t.emoji }}
              <span class="t-en">{{ t.name_en }}</span>
              <span class="t-nl" style="display:none">{{ t.name_nl }}</span>
              <span class="t-fr" style="display:none">{{ t.name_fr }}</span>
            </div>
            <p class="nn-summary">
              <span class="t-en">{{ block.summary_en }}</span>
              <span class="t-nl" style="display:none">{{ block.summary_nl }}</span>
              <span class="t-fr" style="display:none">{{ block.summary_fr }}</span>
            </p>
            <ul class="nn-stories">
              {% for story in block.stories %}
              <li class="nn-story" style="border-left-color:{{ t.accent }}">
                <a href="{{ story.url }}" target="_blank" rel="noopener nofollow">
                  <span class="t-en">{{ story.line_en }}</span>
                  <span class="t-nl" style="display:none">{{ story.line_nl }}</span>
                  <span class="t-fr" style="display:none">{{ story.line_fr }}</span>
                </a>
                <div class="nn-story-meta">
                  {{ story.source }}{% if story.also_in.length %} +{{ story.also_in.length }}{% endif %} · {{ story.date }}
                </div>
              </li>
              {% endfor %}
            </ul>
            {% if block.considered %}
            <div class="nn-considered">
              <span class="t-en">{{ block.considered }} distinct stories considered this week.</span>
              <span class="t-nl" style="display:none">{{ block.considered }} afzonderlijke verhalen deze week bekeken.</span>
              <span class="t-fr" style="display:none">{{ block.considered }} articles distincts examinés cette semaine.</span>
            </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </details>
  {% endfor %}
{% endif %}

</div><!-- /pane-necessary -->

<script>
  var REJECTIONS = {{ rejections.articles | dump | safe }};
  var CAT_META   = {{ catMeta | dump | safe }};
  var SOURCE_BREAKDOWN = {{ (rejections.source_breakdown or []) | dump | safe }};

  var sourceSort = 'absolute';

  function renderSourceBreakdown() {
    var el = document.getElementById('source-breakdown-list');
    if (!el || !SOURCE_BREAKDOWN.length) return;

    var sorted = SOURCE_BREAKDOWN.slice();
    if (sourceSort === 'relative') {
      sorted.sort(function(a, b) {
        return (b.total ? b.negative / b.total : 0) - (a.total ? a.negative / a.total : 0);
      });
    } else {
      sorted.sort(function(a, b) { return b.negative - a.negative; });
    }

    var maxVal = sourceSort === 'relative'
      ? Math.max.apply(null, sorted.map(function(s) { return s.total ? s.negative / s.total : 0; }))
      : sorted[0].negative;

    el.innerHTML = sorted.map(function(s) {
      var pct = s.total ? Math.round(s.negative / s.total * 100) : 0;
      var barWidth = sourceSort === 'relative'
        ? (maxVal > 0 ? Math.round((s.negative / s.total) / maxVal * 100) : 0)
        : (maxVal > 0 ? Math.round(s.negative / maxVal * 100) : 0);

      return '<div class="source-row">'
        + '<div class="source-label">' + escHtml(s.source) + '</div>'
        + '<div class="source-bar-wrap"><div class="source-bar" style="width:' + barWidth + '%;"></div></div>'
        + '<div class="source-count">' + s.negative + ' / ' + s.total + ' (' + pct + '%)</div>'
        + '</div>';
    }).join('');
  }

  function sortSources(mode) {
    sourceSort = mode;
    document.getElementById('sort-abs-btn').classList.toggle('active', mode === 'absolute');
    document.getElementById('sort-rel-btn').classList.toggle('active', mode === 'relative');
    renderSourceBreakdown();
  }

  var activeCat   = 'all';
  var pageSize    = 100;
  var currentPage = 1;

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function getFiltered() {
    if (activeCat === 'all') return REJECTIONS;
    return REJECTIONS.filter(function(r) { return r.category === activeCat; });
  }

  function renderPage() {
    var filtered   = getFiltered();
    var total      = filtered.length;
    var totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    var start = (currentPage - 1) * pageSize;
    var items = filtered.slice(start, start + pageSize);

    var lang = document.documentElement.getAttribute('data-lang') || 'en';

    var html = items.map(function(item) {
      var meta = CAT_META[item.category] || null;
      var borderStyle = meta ? 'border-left-color:' + meta.border + ';' : '';

      var badge = meta
        ? '<span class="cat-badge" style="color:' + meta.border + ';border-color:' + meta.border + ';background:' + meta.color + '20;">'
          + meta.emoji + '&nbsp;'
          + '<span class="t-en"' + (lang!=='en'?' style="display:none"':'') + '>' + meta.label_en + '</span>'
          + '<span class="t-nl"' + (lang!=='nl'?' style="display:none"':'') + '>' + meta.label_nl + '</span>'
          + '<span class="t-fr"' + (lang!=='fr'?' style="display:none"':'') + '>' + meta.label_fr + '</span>'
          + '</span>'
        : '';

      var fallbackReason = '<span class="t-en"' + (lang!=='en'?' style="display:none"':'') + '>does not fit positive news criteria</span>'
        + '<span class="t-nl"' + (lang!=='nl'?' style="display:none"':'') + '>past niet bij positief nieuws</span>'
        + '<span class="t-fr"' + (lang!=='fr'?' style="display:none"':'') + '>ne correspond pas aux critères de l\'actualité positive</span>';

      var scoreBadge = '';
      if (item.positivity_score != null) {
        var s = item.positivity_score;
        var scoreColor = s <= 3 ? '#dc2626' : s <= 6 ? '#d97706' : '#16a34a';
        scoreBadge = '<span style="display:inline-block;font-size:0.7em;font-weight:bold;padding:1px 5px;border-radius:3px;color:#fff;background:' + scoreColor + ';margin-left:6px;" title="Positivity score">' + s + '/10</span>';
      }

      return '<div class="rejection-card" data-cat="' + escHtml(item.category) + '" style="' + borderStyle + '">'
        + '<p class="rejection-title"><a href="' + escHtml(item.url) + '" target="_blank" rel="noopener noreferrer" style="color:inherit;text-decoration:none;">' + escHtml(item.title) + '</a>' + scoreBadge + '</p>'
        + '<div class="rejection-meta"><span>' + escHtml(item.source) + '</span><span>' + escHtml(item.date) + '</span>' + badge + '</div>'
        + '<p class="rejection-reason">' + (item.reason ? escHtml(item.reason) : fallbackReason) + '</p>'
        + '</div>';
    }).join('');

    document.getElementById('rejection-list').innerHTML = html;

    // Update both pagination bars
    var infoText = currentPage + ' / ' + totalPages;
    var isFirst = currentPage === 1;
    var isLast  = currentPage === totalPages;
    ['top','bottom'].forEach(function(side) {
      var infoEl = document.getElementById('page-info-' + side);
      var prevEl = document.getElementById('prev-btn-' + side);
      var nextEl = document.getElementById('next-btn-' + side);
      if (infoEl) infoEl.textContent = infoText;
      if (prevEl) prevEl.disabled = isFirst;
      if (nextEl) nextEl.disabled = isLast;
    });
  }

  function changePage(delta) {
    currentPage += delta;
    renderPage();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function setPageSize(n) {
    pageSize    = n;
    currentPage = 1;
    renderPage();
  }

  function filterCat(cat, btn) {
    activeCat   = cat;
    currentPage = 1;
    document.querySelectorAll('.cat-pill').forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    renderPage();
  }

  // Initial render
  renderSourceBreakdown();
  renderPage();

  // ── Tab switching ────────────────────────────────────────────────────────
  // Two panes share this URL: the skip log and the weekly Necessary Negativity
  // selection. The hash makes each linkable, so the editorial can point
  // straight at /negativity/#necessary.
  function showTab(name) {
    ['skipped', 'necessary'].forEach(function(n) {
      var pane = document.getElementById('pane-' + n);
      var btn  = document.getElementById('tab-' + n);
      if (!pane || !btn) return;
      var on = (n === name);
      pane.hidden = !on;
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    if (history.replaceState) {
      history.replaceState(null, '', name === 'necessary' ? '#necessary' : location.pathname);
    }
  }

  if (location.hash === '#necessary') showTab('necessary');

  // Restore saved language
  (function() {
    var lang = localStorage.getItem('positron-today-lang') || 'en';
    if (lang !== 'en') {
      var btn = document.querySelector('.nav-lang-btn[onclick*="' + lang + '"]');
      setLang(lang, btn);
    }
  })();
</script>
